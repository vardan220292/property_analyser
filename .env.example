# Copy to .env and adjust if needed. All values optional.
PORT=4180
HOST=127.0.0.1
DB_PATH=data/scenarios.db

# Optional: seed an admin account at boot (gk_crm convention).
# PA_BOOTSTRAP_EMAIL=you@example.com
# PA_BOOTSTRAP_PASSWORD=min-8-chars

# Optional: JWT signing secret. If unset, one is generated and stored at
# data/.jwt_secret so logins survive restarts.
# PA_JWT_SECRET=some-long-random-string

# Postgres (Supabase) — set to run on Postgres instead of SQLite.
# Percent-encode special chars in the password (@ -> %40 etc).
# If the direct host times out (IPv6), use the Session pooler string from
# the dashboard Connect page:
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# Public origin clients can reach — share links are built from it.
# PA_BASE_URL=https://pa.yourdomain.com

# Supabase Storage (BA logo upload). Bucket must exist + be public-read.
# PA_SUPABASE_URL=https://<ref>.supabase.co
# PA_SUPABASE_SERVICE_ROLE_KEY=<service role key>
# PA_SUPABASE_BUCKET=pa-branding

# Optional: Domain.com.au address autocomplete (free developer tier).
# Register at developer.domain.com.au, create a project with the properties
# scope, paste the client id/secret here. Unset = falls back to Esri's World
# Geocoding Service (accurate AU house numbers, no key needed) and then to a
# free OSM-based Photon lookup (no key, approximate results).
# PA_DOMAIN_CLIENT_ID=
# PA_DOMAIN_CLIENT_SECRET=

# Optional: Esri World Geocoding Service API key. Unset = keyless
# geocode.arcgis.com, which serves low-volume anonymous calls.
# Free key: developers.arcgis.com
# PA_ARCGIS_API_KEY=

# Optional: AI sold-comps search via Anthropic web search (needs API credits
# from console.anthropic.com — separate from any Claude subscription).
# Unset = the "Find sold comps" button shows a setup hint.
# PA_ANTHROPIC_API_KEY=
